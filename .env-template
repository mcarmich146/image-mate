SATELLOGIC_AUTH_MODE=oauth_client_credentials
SATELLOGIC_KEY_ID=
SATELLOGIC_KEY_SECRET=
SATELLOGIC_CONTRACT_ID=cont.eac744cc-2afe-4012-9621-35623feeb7a7
SATELLOGIC_COLLECTION_ID=l1d-sr
SATELLOGIC_API_BASE_URL=https://api.satellogic.com
SATELLOGIC_STAC_URL=https://api.satellogic.com/archive/stac
SATELLOGIC_TOKEN_URL=https://auth.platform.satellogic.com/oauth/token
SATELLOGIC_COG_TIMEOUT_SECONDS=180

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Local L1D-SR aircraft detector. Use "auto" to prefer CoreML on Apple Silicon,
# then CUDA on NVIDIA, and otherwise CPU. Use "coreml" or "cuda" to require it.
IMAGE_MATE_AIRCRAFT_MODEL=yolo11n-obb.onnx
IMAGE_MATE_AIRCRAFT_PROVIDER=auto
IMAGE_MATE_AIRCRAFT_CONFIDENCE=0.25
IMAGE_MATE_AIRCRAFT_IOU=0.45
IMAGE_MATE_AIRCRAFT_MAX_DETECTIONS=200
IMAGE_MATE_AIRCRAFT_WINDOW_PX=1024
IMAGE_MATE_AIRCRAFT_WINDOW_OVERLAP=0.20
IMAGE_MATE_AIRCRAFT_LAB_DIR=backend/output/aircraft-lab
IMAGE_MATE_AIRCRAFT_TRAINING_DIR=artifacts/aircraft-training
# Optional host Python with Ultralytics/PyTorch/MPS or CUDA for Model Lab jobs.
# IMAGE_MATE_AIRCRAFT_TRAINING_PYTHON=/path/to/training-venv/bin/python

# Optional direct API transport for the Luna reviewer. The default transport
# uses the Hermes-managed CLI route and does not need a project API key.
IMAGE_MATE_LUNA_TRANSPORT=hermes
IMAGE_MATE_LUNA_MODEL=gpt-5.6-luna
IMAGE_MATE_LUNA_HERMES_BIN=/Users/mark/.hermes/bin/hermes

IMAGE_MATE_HOST=127.0.0.1
IMAGE_MATE_PORT=8000
IMAGE_MATE_DEV_RELOAD=true
IMAGE_MATE_CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000
IMAGE_MATE_PROXY_ALLOWED_HOSTS=api.satellogic.com,platform.satellogic.com,auth.platform.satellogic.com,satellogic-production-eo-backend-catalog.s3.amazonaws.com,sh.dataspace.copernicus.eu,catalogue.dataspace.copernicus.eu,identity.dataspace.copernicus.eu
# Optional authoritative spacecraft-generation mapping. Do not infer generation from GSD.
SATELLOGIC_SATELLITE_GENERATION_MAP={}
IMAGE_MATE_MOSAIC_MAX_OUTPUT_PIXELS=500000000
IMAGE_MATE_MOSAIC_MAX_INPUT_BYTES=536870912
IMAGE_MATE_MOSAIC_WORKER_ENABLED=true
# auto, cpu, mps, cuda, or opencl. The UI accelerator selection overrides this.
IMAGE_MATE_MOSAIC_ACCELERATOR=auto
# Optional absolute paths when the API and host worker use different Python runtimes.
IMAGE_MATE_MOSAIC_WORKER_PYTHON=
IMAGE_MATE_MOSAIC_WORKER_API_BASE_URL=http://127.0.0.1:8000
IMAGE_MATE_MOSAIC_PRODUCT_POLL_ENABLED=true
IMAGE_MATE_MOSAIC_PRODUCT_POLL_SECONDS=300

# Archive-watch email notifications. Leave SMTP fields empty to use the UI/API
# without delivery; new items remain pending until delivery is configured.
IMAGE_MATE_PUBLIC_BASE_URL=http://127.0.0.1:8000
IMAGE_MATE_ARCHIVE_WATCH_ENABLED=true
IMAGE_MATE_ARCHIVE_WATCH_INTERVAL_SECONDS=300
IMAGE_MATE_ARCHIVE_WATCH_DEFAULT_LOOKBACK_HOURS=72
IMAGE_MATE_ALERT_EMAIL_TO=
IMAGE_MATE_SMTP_HOST=
IMAGE_MATE_SMTP_PORT=587
IMAGE_MATE_SMTP_USERNAME=
IMAGE_MATE_SMTP_PASSWORD=
IMAGE_MATE_SMTP_FROM=
IMAGE_MATE_SMTP_USE_TLS=true
IMAGE_MATE_SMTP_USE_SSL=false
IMAGE_MATE_SMTP_TIMEOUT_SECONDS=30

MERLIN_S2_ENABLED=true
CDSE_DOWNLOAD_CLIENT_ID=cdse-public
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_WMTS_INSTANCE_ID=
CDSE_DOWNLOAD_USERNAME=
CDSE_DOWNLOAD_PASSWORD=
CDSE_WMTS_LAYER_ID=TRUE-COLOR
